#!/bin/bash
# =============================================================================
#  hbm - Hostalika Backup Manager
#  Version: 2.5.0
#  Usage: hbm <command> [options]
# =============================================================================

REPO_URL="https://raw.githubusercontent.com/Hostalika/cpanel-backup/main"
REPO_API="https://api.github.com/repos/Hostalika/cpanel-backup/contents"
INSTALL_DIR="/opt/hostalika-backup"
SCRIPT="/usr/local/bin/cpanel_backup.sh"
BOT="/usr/local/bin/cpanel_backup_bot.py"
LOG_FILE="/var/log/cpanel_backup.log"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

ok()   { echo -e "  ${GREEN}[OK]${NC}    $1"; }
fail() { echo -e "  ${RED}[FAIL]${NC}  $1"; }
warn() { echo -e "  ${YELLOW}[WARN]${NC}  $1"; }

# Extract value from bash variable assignment: VAR="value" -> value
get_sh_val() {
    grep "^${1}=" "$SCRIPT" 2>/dev/null | cut -d'=' -f2- | tr -d '"' | tr -d "'"
}

# Extract value from python variable assignment: VAR     = "value" -> value
get_py_val() {
    grep "^${1} " "$BOT" 2>/dev/null | cut -d'=' -f2- | tr -d '"' | tr -d "'" | tr -d ' '
}

# Set value in bash script
set_sh_val() {
    sed -i "s|^${1}=.*|${1}=\"${2}\"|" "$SCRIPT"
}

# Set value in python bot script
set_py_val() {
    local key="$1"
    local val="$2"
    local padded
    padded=$(printf "%-13s" "$key")
    sed -i "s|^${key}[[:space:]]*=.*|${padded}= \"${val}\"|" "$BOT"
}

cmd_help() {
    local ver
    ver=$(cat "${INSTALL_DIR}/VERSION" 2>/dev/null || echo "?")
    echo ""
    echo -e "${BLUE}Hostalika Backup Manager v${ver}${NC}"
    echo ""
    echo "Usage: hbm <command> [options]"
    echo ""
    echo "System:"
    echo "  hbm install              Install the backup system"
    echo "  hbm update               Update to latest version"
    echo "  hbm remove               Uninstall everything"
    echo "  hbm version              Show current version"
    echo "  hbm status               Show system status"
    echo "  hbm config               Edit configuration"
    echo "  hbm test                 Run full diagnostics"
    echo ""
    echo "Backup:"
    echo "  hbm backup               Start a full backup now"
    echo "  hbm backup <user>        Backup a single account"
    echo "  hbm restore <user>       Restore latest backup"
    echo "  hbm restore <user> <date>  Restore from specific date"
    echo ""
    echo "Info:"
    echo "  hbm logs                 Show last 50 log lines"
    echo "  hbm logs live            Follow log in real-time"
    echo "  hbm list                 List available backups"
    echo "  hbm disk                 Show disk usage"
    echo ""
    echo "Maintenance:"
    echo "  hbm clean                Remove stale temp folders"
    echo "  hbm restart              Restart Telegram bot"
    echo ""
}

cmd_version() {
    local ver remote
    ver=$(cat "${INSTALL_DIR}/VERSION" 2>/dev/null || echo "unknown")
    remote=$(curl -fsSL "${REPO_URL}/VERSION" 2>/dev/null | tr -d '[:space:]')
    echo "Installed : v${ver}"
    echo "Latest    : v${remote}"
    if [ "$ver" != "$remote" ]; then
        echo -e "${YELLOW}Update available: run hbm update${NC}"
    else
        echo -e "${GREEN}Up to date${NC}"
    fi
}

cmd_status() {
    local ver bot_status cron_line rhost ruser keep last_run last_status disk
    ver=$(cat "${INSTALL_DIR}/VERSION" 2>/dev/null || echo "unknown")
    bot_status=$(systemctl is-active cpanel-backup-bot 2>/dev/null || echo "not installed")
    cron_line=$(crontab -l 2>/dev/null | grep cpanel_backup | awk '{print $1,$2,$3,$4,$5}' || echo "not set")
    rhost=$(get_sh_val REMOTE_HOST)
    ruser=$(get_sh_val REMOTE_USER)
    keep=$(grep '^KEEP_BACKUPS=' "$SCRIPT" 2>/dev/null | cut -d'=' -f2)
    last_run=$(grep 'Backup Report' "$LOG_FILE" 2>/dev/null | tail -1 | awk '{print $1,$2}')
    last_status=$(grep 'Backup Report -' "$LOG_FILE" 2>/dev/null | tail -1 | grep -oP '(?<=- ).*')
    disk=$(df -h /backup 2>/dev/null | awk 'NR==2 {print $3" used / "$2" total ("$5")"}')
    echo "=============================================="
    echo "   Hostalika Backup System Status"
    echo "=============================================="
    echo "Version      : ${ver}"
    echo "Bot service  : ${bot_status}"
    echo "Cron         : ${cron_line:-not set}"
    echo "Backup server: ${rhost}"
    echo "SSH user     : ${ruser}"
    echo "Keep backups : ${keep}"
    echo "Last run     : ${last_run:-never}"
    echo "Last status  : ${last_status:-N/A}"
    echo "Disk (local) : ${disk}"
    echo "=============================================="
}

ask_schedule() {
    echo ""
    echo "  Backup schedule:"
    echo "    1) Daily"
    echo "    2) Every 2 days"
    echo "    3) Every 3 days"
    echo "    4) Weekly (every Friday)"
    echo "    5) Custom (cron expression)"
    echo ""
    local choice hour cron desc
    read -p "  Choose [1-5]: " choice
    if [ -n "$choice" ]; then
        read -p "  At what hour? (0-23) [default: 2]: " hour
        hour=${hour:-2}
        case "$choice" in
            1) cron="0 ${hour} * * *";   desc="daily at ${hour}:00" ;;
            2) cron="0 ${hour} */2 * *"; desc="every 2 days at ${hour}:00" ;;
            3) cron="0 ${hour} */3 * *"; desc="every 3 days at ${hour}:00" ;;
            4) cron="0 ${hour} * * 5";   desc="every Friday at ${hour}:00" ;;
            5) read -p "  Enter cron expression: " cron; desc="custom: ${cron}" ;;
            *) return ;;
        esac
        if [ -n "$cron" ]; then
            (crontab -l 2>/dev/null | grep -v cpanel_backup; \
             echo "${cron} /usr/local/bin/cpanel_backup.sh >> ${LOG_FILE} 2>&1") | crontab -
            echo -e "  ${GREEN}Schedule set: ${desc}${NC}"
        fi
    fi
}

cmd_config() {
    local v cur_host cur_user cur_port cur_keep cur_token cur_chats
    cur_host=$(get_sh_val REMOTE_HOST)
    cur_user=$(get_sh_val REMOTE_USER)
    cur_port=$(get_sh_val REMOTE_PORT)
    cur_keep=$(grep '^KEEP_BACKUPS=' "$SCRIPT" 2>/dev/null | cut -d'=' -f2)
    cur_token=$(get_sh_val TELEGRAM_BOT_TOKEN)
    cur_chats=$(get_sh_val TELEGRAM_CHAT_IDS)

    echo -e "\n${BLUE}Current Configuration:${NC}"
    echo "----------------------------------------"
    echo "Backup server IP   : ${cur_host}"
    echo "Backup server user : ${cur_user}"
    echo "Backup server port : ${cur_port}"
    echo "Keep backups       : ${cur_keep}"
    echo "Telegram token     : ${cur_token}"
    echo "Telegram chat IDs  : ${cur_chats}"
    echo "Cron               : $(crontab -l 2>/dev/null | grep cpanel_backup | awk '{print $1,$2,$3,$4,$5}' || echo 'not set')"
    echo "----------------------------------------"
    echo -e "\n${YELLOW}Leave blank to keep current value${NC}\n"

    read -p "  Backup server IP       [${cur_host}]: " v
    if [ -n "$v" ]; then
        set_sh_val REMOTE_HOST "$v"
        set_py_val REMOTE_HOST "$v"
        cur_host="$v"
    fi

    read -p "  Backup server SSH user [${cur_user}]: " v
    if [ -n "$v" ]; then
        set_sh_val REMOTE_USER "$v"
        set_py_val REMOTE_USER "$v"
        cur_user="$v"
    fi

    read -p "  Backup server SSH port [${cur_port}]: " v
    [ -n "$v" ] && set_sh_val REMOTE_PORT "$v" && cur_port="$v"

    read -p "  Keep N backups         [${cur_keep}]: " v
    [ -n "$v" ] && sed -i "s|^KEEP_BACKUPS=.*|KEEP_BACKUPS=${v}|" "$SCRIPT"

    read -p "  Telegram Bot Token     [${cur_token}]: " v
    if [ -n "$v" ]; then
        set_sh_val TELEGRAM_BOT_TOKEN "$v"
        set_py_val BOT_TOKEN "$v"
    fi

    read -p "  Telegram Chat ID(s)    [${cur_chats}]: " v
    [ -n "$v" ] && set_sh_val TELEGRAM_CHAT_IDS "$v"

    ask_schedule

    echo -e "\n${GREEN}Configuration updated.${NC}"
    systemctl restart cpanel-backup-bot 2>/dev/null && echo "Bot restarted." || true

    echo -e "\n${BLUE}Testing SSH connection...${NC}"
    local rhost ruser rport skey
    rhost=$(get_sh_val REMOTE_HOST)
    ruser=$(get_sh_val REMOTE_USER)
    rport=$(get_sh_val REMOTE_PORT)
    skey=$(get_sh_val SSH_KEY)
    if ssh -i "$skey" -p "$rport" -o ConnectTimeout=10 -o StrictHostKeyChecking=no \
       -o BatchMode=yes "${ruser}@${rhost}" "echo ok" &>/dev/null; then
        echo -e "${GREEN}Connection successful!${NC}"
    else
        echo -e "${RED}Connection failed. Add this key to ${rhost}:${NC}"
        cat "${skey}.pub" 2>/dev/null || echo "Key not found: ${skey}.pub"
    fi
}

cmd_test() {
    local rhost ruser rport skey bot_token free rdisk tg_ok
    rhost=$(get_sh_val REMOTE_HOST)
    ruser=$(get_sh_val REMOTE_USER)
    rport=$(get_sh_val REMOTE_PORT)
    skey=$(get_sh_val SSH_KEY)
    bot_token=$(get_sh_val TELEGRAM_BOT_TOKEN)

    echo -e "\n${BLUE}====== Hostalika Backup System - Diagnostics ======${NC}\n"
    [ -f /usr/local/cpanel/bin/pkgacct ] && ok "cPanel found"     || fail "cPanel not found"
    command -v curl    &>/dev/null && ok "curl installed"    || fail "curl not installed"
    command -v rsync   &>/dev/null && ok "rsync installed"   || fail "rsync not installed"
    command -v python3 &>/dev/null && ok "python3 installed" || fail "python3 not installed"
    [ -f "$skey" ]                 && ok "SSH key exists"    || fail "SSH key missing: $skey"

    if ssh -i "$skey" -p "$rport" -o ConnectTimeout=10 -o StrictHostKeyChecking=no \
       -o BatchMode=yes "${ruser}@${rhost}" "echo ok" &>/dev/null; then
        ok "SSH connection to ${rhost}"
    else
        fail "SSH connection to ${rhost} failed"
    fi

    if rsync -e "ssh -i ${skey} -p ${rport} -o StrictHostKeyChecking=no" \
       --dry-run /etc/hostname "${ruser}@${rhost}:/tmp/" &>/dev/null; then
        ok "rsync works"
    else
        fail "rsync failed"
    fi

    free=$(df -BG /backup 2>/dev/null | awk 'NR==2 {print $4}' | tr -d 'G')
    if [ -n "$free" ] && [ "$free" -gt 20 ]; then
        ok "Local disk: ${free}GB free"
    else
        warn "Local disk low: ${free}GB free"
    fi

    rdisk=$(ssh -i "$skey" -p "$rport" -o StrictHostKeyChecking=no \
        "${ruser}@${rhost}" "df -h /backup 2>/dev/null | awk 'NR==2 {print \$4}'" 2>/dev/null)
    [ -n "$rdisk" ] && ok "Backup server disk: ${rdisk} free" || warn "Could not check backup server disk"

    tg_ok=$(curl -s "https://api.telegram.org/bot${bot_token}/getMe" 2>/dev/null | \
        python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('ok',''))" 2>/dev/null)
    [ "$tg_ok" = "True" ] && ok "Telegram bot token valid" || fail "Telegram bot token invalid"

    systemctl is-active cpanel-backup-bot &>/dev/null && ok "Bot service running" || warn "Bot service not running"

    if crontab -l 2>/dev/null | grep -q cpanel_backup; then
        ok "Cron: $(crontab -l 2>/dev/null | grep cpanel_backup | awk '{print $1,$2,$3,$4,$5}')"
    else
        warn "Cron job not set"
    fi

    echo -e "\n${BLUE}===================================================${NC}\n"
}

download_file() {
    local filename="$1"
    local dest="$2"
    curl -fsSL "${REPO_API}/${filename}" \
        | python3 -c "import sys,json,base64; d=json.load(sys.stdin); open('${dest}','w').write(base64.b64decode(d['content']).decode())"
}

cmd_update() {
    local remote_ver local_ver
    echo "[hbm] Checking for updates..."
    remote_ver=$(curl -fsSL "${REPO_URL}/VERSION" 2>/dev/null | tr -d '[:space:]')
    local_ver=$(cat "${INSTALL_DIR}/VERSION" 2>/dev/null | tr -d '[:space:]' || echo "0.0.0")
    if [ "$remote_ver" = "$local_ver" ]; then
        echo "Already up to date (v${local_ver})"
        exit 0
    fi
    echo "Updating from v${local_ver} to v${remote_ver}..."

    # Save all current settings
    local s_host s_user s_port s_dir s_key s_temp s_keep s_bot s_chats s_log
    local b_token b_ruser b_rhost b_auth
    s_host=$(get_sh_val REMOTE_HOST)
    s_user=$(get_sh_val REMOTE_USER)
    s_port=$(get_sh_val REMOTE_PORT)
    s_dir=$(get_sh_val REMOTE_DIR)
    s_key=$(get_sh_val SSH_KEY)
    s_temp=$(get_sh_val LOCAL_TEMP_DIR)
    s_keep=$(grep '^KEEP_BACKUPS=' "$SCRIPT" 2>/dev/null | cut -d'=' -f2)
    s_bot=$(get_sh_val TELEGRAM_BOT_TOKEN)
    s_chats=$(get_sh_val TELEGRAM_CHAT_IDS)
    s_log=$(get_sh_val LOG_FILE)
    b_token=$(get_py_val BOT_TOKEN)
    b_ruser=$(get_py_val REMOTE_USER)
    b_rhost=$(get_py_val REMOTE_HOST)
    # Save authorized users block from bot
    b_auth=$(python3 -c "
import re
content = open('${BOT}').read()
m = re.search(r'AUTHORIZED_USERS\s*=\s*\[(.*?)\]', content, re.DOTALL)
if m:
    users = re.findall(r'\"(\d+)\"', m.group(1))
    print('\n'.join(users))
" 2>/dev/null)

    # Download new files via API to bypass CDN cache
    echo "Downloading updated files..."
    download_file "cpanel_backup.sh"     "/usr/local/bin/cpanel_backup.sh"
    download_file "cpanel_backup_bot.py" "/usr/local/bin/cpanel_backup_bot.py"
    download_file "hbm"                  "/usr/local/bin/hbm"
    chmod 700 /usr/local/bin/cpanel_backup.sh
    chmod 700 /usr/local/bin/cpanel_backup_bot.py
    chmod +x  /usr/local/bin/hbm

    # Restore settings to backup script
    [ -n "$s_host"  ] && set_sh_val REMOTE_HOST        "$s_host"
    [ -n "$s_user"  ] && set_sh_val REMOTE_USER        "$s_user"
    [ -n "$s_port"  ] && set_sh_val REMOTE_PORT        "$s_port"
    [ -n "$s_dir"   ] && set_sh_val REMOTE_DIR         "$s_dir"
    [ -n "$s_key"   ] && set_sh_val SSH_KEY            "$s_key"
    [ -n "$s_temp"  ] && set_sh_val LOCAL_TEMP_DIR     "$s_temp"
    [ -n "$s_keep"  ] && sed -i "s|^KEEP_BACKUPS=.*|KEEP_BACKUPS=${s_keep}|" "$SCRIPT"
    [ -n "$s_bot"   ] && set_sh_val TELEGRAM_BOT_TOKEN "$s_bot"
    [ -n "$s_chats" ] && set_sh_val TELEGRAM_CHAT_IDS  "$s_chats"
    [ -n "$s_log"   ] && set_sh_val LOG_FILE           "$s_log"

    # Restore settings to bot script
    [ -n "$b_token" ] && set_py_val BOT_TOKEN    "$b_token"
    [ -n "$b_ruser" ] && set_py_val REMOTE_USER  "$b_ruser"
    [ -n "$b_rhost" ] && set_py_val REMOTE_HOST  "$b_rhost"

    # Restore authorized users
    if [ -n "$b_auth" ]; then
        local users_str=""
        while IFS= read -r uid; do
            [ -n "$uid" ] && users_str+="    \"${uid}\",\n"
        done <<< "$b_auth"
        python3 -c "
import re
content = open('${BOT}').read()
new_block = 'AUTHORIZED_USERS = [\n${users_str}]'
content = re.sub(r'AUTHORIZED_USERS\s*=\s*\[.*?\]', new_block, content, flags=re.DOTALL)
open('${BOT}','w').write(content)
" 2>/dev/null
    fi

    echo "$remote_ver" > "${INSTALL_DIR}/VERSION"
    systemctl restart cpanel-backup-bot 2>/dev/null || true
    echo "Update complete - v${remote_ver}"
    echo "All settings preserved."
}

cmd_remove() {
    local confirm
    read -p "Are you sure you want to uninstall? (yes/no): " confirm
    [ "$confirm" != "yes" ] && echo "Aborted." && exit 0
    echo "Uninstalling Hostalika Backup System..."
    systemctl stop cpanel-backup-bot 2>/dev/null || true
    systemctl disable cpanel-backup-bot 2>/dev/null || true
    rm -f /etc/systemd/system/cpanel-backup-bot.service
    systemctl daemon-reload
    crontab -l 2>/dev/null | grep -v cpanel_backup | crontab - 2>/dev/null || true
    rm -f /usr/local/bin/cpanel_backup.sh
    rm -f /usr/local/bin/cpanel_backup_bot.py
    rm -f /usr/local/bin/hbm
    rm -f /usr/local/bin/hbm-*
    rm -rf /opt/hostalika-backup
    echo "Uninstall complete."
    echo "Note: /backup/temp_cpanel and SSH keys were NOT removed."
}

cmd_logs() {
    if [ "$1" = "live" ]; then
        tail -f "$LOG_FILE"
    else
        tail -50 "$LOG_FILE"
    fi
}

cmd_disk() {
    local rhost ruser rport skey
    rhost=$(get_sh_val REMOTE_HOST)
    ruser=$(get_sh_val REMOTE_USER)
    rport=$(get_sh_val REMOTE_PORT)
    skey=$(get_sh_val SSH_KEY)
    echo "=== Local Server ==="
    df -h /backup
    echo ""
    echo "=== Backup Server (${rhost}) ==="
    ssh -i "$skey" -p "$rport" -o StrictHostKeyChecking=no "${ruser}@${rhost}" "df -h /backup"
}

cmd_list() {
    local rhost ruser rport skey rdir
    rhost=$(get_sh_val REMOTE_HOST)
    ruser=$(get_sh_val REMOTE_USER)
    rport=$(get_sh_val REMOTE_PORT)
    skey=$(get_sh_val SSH_KEY)
    rdir=$(get_sh_val REMOTE_DIR)
    echo "=== Available Backups on ${rhost} ==="
    ssh -i "$skey" -p "$rport" -o StrictHostKeyChecking=no "${ruser}@${rhost}" \
        "for d in \$(ls -dt ${rdir}/????-??-??_??-?? 2>/dev/null); do
            count=\$(ls \$d/*.tar.gz \$d/*.tar 2>/dev/null | wc -l)
            size=\$(du -sh \$d | cut -f1)
            echo \"  \$(basename \$d)  |  \${count} accounts  |  \${size}\"
         done" 2>/dev/null || echo "No backups found"
}

cmd_clean() {
    local temp_dir count d sz
    temp_dir="/backup/temp_cpanel"
    count=0
    echo "Checking for stale temp folders..."
    for d in "${temp_dir}"/????-??-??_??-??; do
        [ -d "$d" ] || continue
        sz=$(du -sh "$d" | cut -f1)
        rm -rf "$d"
        echo -e "  ${YELLOW}[REMOVED]${NC} $(basename "$d") ($sz)"
        count=$((count + 1))
    done
    if [ "$count" -eq 0 ]; then
        echo -e "  ${GREEN}No stale folders found.${NC}"
    else
        echo -e "\n  ${GREEN}Removed $count folder(s).${NC}"
    fi
    echo "Current usage: $(du -sh "${temp_dir}" 2>/dev/null | cut -f1)"
}

cmd_backup() {
    local target rhost ruser rport skey rdir date_str tmpdir file fsz
    target="$1"
    if [ -z "$target" ]; then
        echo "Starting full backup in background..."
        echo "Monitor: hbm logs live"
        nohup /usr/local/bin/cpanel_backup.sh >> "$LOG_FILE" 2>&1 &
        echo "Backup started with PID: $!"
    else
        [ ! -d "/var/cpanel/users/${target}" ] && echo "Account not found: ${target}" && exit 1
        rhost=$(get_sh_val REMOTE_HOST)
        ruser=$(get_sh_val REMOTE_USER)
        rport=$(get_sh_val REMOTE_PORT)
        skey=$(get_sh_val SSH_KEY)
        rdir=$(get_sh_val REMOTE_DIR)
        date_str=$(date +"%Y-%m-%d_%H-%M")
        tmpdir="/backup/temp_cpanel/single-${date_str}"
        echo "Backing up account: ${target}"
        mkdir -p "$tmpdir"
        /usr/local/cpanel/bin/pkgacct "$target" "$tmpdir"
        file=$(ls "${tmpdir}/cpmove-${target}.tar.gz" 2>/dev/null || \
               ls "${tmpdir}/cpmove-${target}.tar" 2>/dev/null)
        if [ -n "$file" ] && [ -f "$file" ]; then
            fsz=$(du -sh "$file" | cut -f1)
            echo "Transferring to backup server... (${fsz})"
            ssh -i "$skey" -p "$rport" -o StrictHostKeyChecking=no \
                "${ruser}@${rhost}" "mkdir -p ${rdir}/single-accounts"
            rsync -avz -e "ssh -i ${skey} -p ${rport} -o StrictHostKeyChecking=no" \
                "$file" "${ruser}@${rhost}:${rdir}/single-accounts/"
            rm -rf "$tmpdir"
            echo "Done: ${target} backed up to ${rhost}:${rdir}/single-accounts/"
        else
            echo "Backup failed for: ${target}"
            rm -rf "$tmpdir"
            exit 1
        fi
    fi
}

cmd_restore() {
    local username rhost ruser rport skey rdir backup_path
    [ -z "$1" ] && { echo "Usage: hbm restore <username> [date]"; cmd_list; exit 1; }
    username="$1"
    rhost=$(get_sh_val REMOTE_HOST)
    ruser=$(get_sh_val REMOTE_USER)
    rport=$(get_sh_val REMOTE_PORT)
    skey=$(get_sh_val SSH_KEY)
    rdir=$(get_sh_val REMOTE_DIR)
    if [ -n "$2" ]; then
        backup_path="${rdir}/${2}/cpmove-${username}.tar.gz"
    else
        backup_path=$(ssh -i "$skey" -p "$rport" -o StrictHostKeyChecking=no \
            "${ruser}@${rhost}" \
            "ls -t ${rdir}/????-??-??_??-??/cpmove-${username}.tar.gz 2>/dev/null | head -1")
    fi
    [ -z "$backup_path" ] && echo "No backup found for: ${username}" && exit 1
    echo "Restoring : ${username}"
    echo "Source    : ${rhost}:${backup_path}"
    echo "Target    : /home/"
    scp -i "$skey" -P "$rport" -o StrictHostKeyChecking=no \
        "${ruser}@${rhost}:${backup_path}" /home/
    echo ""
    echo "File: /home/$(basename "$backup_path")"
    echo "Restore via WHM: Transfers > Restore a Full Backup/cpmove File"
}

cmd_restart() {
    systemctl restart cpanel-backup-bot
    systemctl status cpanel-backup-bot
}

cmd_install() {
    bash <(curl -s "https://raw.githubusercontent.com/Hostalika/cpanel-backup/main/install.sh")
}

case "$1" in
    install)          cmd_install ;;
    update)           cmd_update ;;
    remove|uninstall) cmd_remove ;;
    version)          cmd_version ;;
    status)           cmd_status ;;
    config)           cmd_config ;;
    test)             cmd_test ;;
    logs)             cmd_logs "$2" ;;
    disk)             cmd_disk ;;
    list)             cmd_list ;;
    clean)            cmd_clean ;;
    backup)           cmd_backup "$2" ;;
    restore)          cmd_restore "$2" "$3" ;;
    restart)          cmd_restart ;;
    help|--help|-h|"") cmd_help ;;
    *)
        echo -e "${RED}Unknown command: $1${NC}"
        echo "Run 'hbm help' to see available commands."
        exit 1
        ;;
esac
